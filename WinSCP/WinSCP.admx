<?xml version="1.0" encoding="utf-8"?>
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
    <policyNamespaces>
	    <target prefix="WinSCP" namespace="WinSCP.Policies.WinSCP"/>
	    <using prefix="windows" namespace="Microsoft.Policies.Windows"/>
    </policyNamespaces>
    <resources minRequiredRevision="1.0" />
    <categories>
        <category name="WinSCP" displayName="$(string.WinSCPSettingCategory)"/>
    </categories>
    <policies>
        <policy name="Period" class ="User" displayName="$(string.Period)" explainText="$(string.Period_help)" presentation="$(presentation.Period_Pres)" key="SOFTWARE\Martin Prikyl\WinSCP 2\Configuration\Interface\Updates">
        <parentCategory ref="WinSCP"/>
        <supportedOn ref="windows:SUPPORTED_Windows_10_0"/>
        <elements>
            <enum id="Period_Dropdown" valueName="Period">
            <item displayName="$(string.Never)">
                <value>
                    <decimal value="0" />
                </value>
            </item>
            <item displayName="$(string.Daily)">
                <value>
                    <decimal value="1" />
                </value>
            </item>
            <item displayName="$(string.Weekly)">
                <value>
                    <decimal value="7" />
                </value>
            </item>
            <item displayName="$(string.Monthly)">
                <value>
                    <decimal value="30" />
                </value>
            </item>
            </enum>
        </elements>
        </policy>
        <policy name="ShowOnStartup" class="User" displayName="$(string.ShowOnStartup)" explainText="$(string.ShowOnStartup_help)" key="SOFTWARE\Martin Prikyl\WinSCP 2\Configuration\Interface\Updates" valueName="ShowOnStartup">
        <parentCategory ref="WinSCP" />
        <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
        <enabledValue>
            <decimal value="1" />
        </enabledValue>
        <disabledValue>
            <decimal value="0" />
        </disabledValue>
        </policy>
        <policy name="BetaVersions" class="User" displayName="$(string.BetaVersions)" explainText="$(string.BetaVersions_help)" presentation="$(presentation.BetaVersions_Pres)" key="SOFTWARE\Martin Prikyl\WinSCP 2\Configuration\Interface\Updates">
        <parentCategory ref="WinSCP" />
        <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
        <elements>
            <enum id="BetaVersions_Dropdown" valueName="BetaVersions">
                <item displayName="$(string.Auto)">
                    <value>
                        <decimal value="2" />
                    </value>
                </item>
                <item displayName="$(string.Off)">
                    <value>
                        <decimal value="1" />
                    </value>
                </item>
                <item displayName="$(string.On)">
                    <value>
                        <decimal value="0" />
                    </value>
                </item>
            </enum>
        </elements>
        </policy>
    </policies>
</policyDefinitions>
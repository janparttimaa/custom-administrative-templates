<?xml version="1.0" encoding="utf-8"?>
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
    <policyNamespaces>
	    <target prefix="DockerDesktop" namespace="Docker.Policies.DockerDesktop"/>
	    <using prefix="windows" namespace="Microsoft.Policies.Windows"/>
    </policyNamespaces>
    <resources minRequiredRevision="1.0" />
    <categories>
        <category name="DockerDesktop" displayName="$(string.DockerDesktopSettingCategory)"/>
    </categories>
    <policies>
        <!-- Enforce sign-in -->
        <policy name="AllowedOrgs" class ="Machine" displayName="$(string.Policy_AllowedOrgs)" explainText="$(string.Explain_AllowedOrgs)" key="SOFTWARE\Policies\Docker\Docker Desktop" presentation="$(presentation.Policy_AllowedOrgs)">
        <parentCategory ref="DockerDesktop"/>
        <supportedOn ref="windows:SUPPORTED_Windows_10_0"/>
        <elements>
            <multiText id="AllowedOrgs" valueName="AllowedOrgs" required="true" />
        </elements>
        </policy>
    </policies>
</policyDefinitions>
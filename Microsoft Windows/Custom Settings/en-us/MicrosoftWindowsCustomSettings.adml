<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.0" schemaVersion="1.0" xmlns="http://www.microsoft.com/GroupPolicy/PolicyDefinitions">
  <displayName>Windows Custom Group Policy Settings</displayName>
  <description>Various Custom Group Policy Settings for Windows 10 and later</description>
  <resources>
    <stringTable>
      <!-- General -->
      <string id="WindowsCustomSettingCategory">Windows - Custom Settings</string>

      <!-- Block AADWorkplaceJoin -->
      <string id="BlockAADWorkplaceJoin">BlockAADWorkplaceJoin</string>
      <string id="BlockAADWorkplaceJoin_help">This setting block users from adding more work accounts (Microsoft Entra registered) on corporate Windows 10/11 devices.

If you enable this setting, users cannot add more work accounts.

If you disable or do not configure this setting, users can add more work accounts.

More information: https://learn.microsoft.com/en-us/entra/identity/devices/faq#how-can-i-block-users-from-adding-more-work-accounts--microsoft-entra-registered--on-my-corporate-windows-10-11-devices
      </string>
      <!-- Internet Explorer: Do not save encrypted pages to disk -->
      <string id="DisableCachingOfSSLPages">DisableCachingOfSSLPages</string>
      <string id="DisableCachingOfSSLPages_help">This policy setting allows you to manage whether Internet Explorer will save encrypted pages that contain secure (HTTPS) information such as passwords and credit card numbers to the Internet Explorer cache, which may be insecure.

If you enable this policy setting, Internet Explorer will not save encrypted pages containing secure (HTTPS) information to the cache.

If you disable this policy setting, Internet Explorer will save encrypted pages containing secure (HTTPS) information to the cache.

If you do not configure this policy, Internet Explorer will save encrypted pages containing secure (HTTPS) information to the cache.
      </string>
    </stringTable>
  </resources>
</policyDefinitionResources>